---
// src/pages/email-search-engine.astro
import SectionedPageLayout from '../layouts/SectionedPageLayout.astro';
import type { SectionItem } from '../components/SectionSidebar.astro';

const sections: SectionItem[] = [
  { id: 'problem', label: 'Problem' },
  { id: 'methods', label: 'Methods' },
  { id: 'findings', label: 'Process' },
  { id: 'recommendations', label: 'Demo' },
  { id: 'publication', label: 'Publication' },
];
---

<SectionedPageLayout title="Voice Agent Engineering" sections={sections}>
  <!-- Problem -->
  <section
    id="problem"
    class="scroll-mt-40 md:flex md:items-stretch gap-x-10"
    role="region"
    aria-labelledby="problem-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="problem-heading" class="text-2xl font-semibold">Problem</h2>
      <p>
        Quadriplegics are individuals with little to no movement in all four limbs and their fingers.
      </p>
      <p>
        As such, they rely on single-swtich devices to operate technology
      </p>
      <p>
        However, telephone functions are often time-sensitive (i.e. Carriers will force calls to voicemail after 6 rings),
        which is too fast for quadriplegics to answer using single-swtich devices
      </p>
    </article>
    <div class="md:w-[65%] md:flex md:flex-col mt-6 md:mt-0">
      <figure class="flex-1 flex flex-col min-h-0">
        <iframe
          src="https://www.youtube.com/embed/0SChphvFTSg"
          title="Basic Introduction to Switch Control"
          class="rounded-xl border w-full h-auto aspect-video md:flex-1 md:min-h-0 md:h-full md:aspect-auto"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </figure>
    </div>
  </section>

  <!-- Methods -->
  <section
    id="methods"
    class="scroll-mt-40 md:flex md:items-stretch gap-x-10"
    role="region"
    aria-labelledby="methods-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="methods-heading" class="text-2xl font-semibold">Methods</h2>
      <p>
        Proposed use of Automatic Speech Recogntiion, specifically Wake-Word detection
      </p>
      <p>
        Quadriplegics speak slower than those without disordered speech, but they can speak faster than they can use single-switch devices
      </p>
    </article>
    <div class="md:w-[65%] md:flex md:flex-col mt-6 md:mt-0">
      <figure class="flex-1 flex flex-col min-h-0">
        <img
          src="/images/asr-methods.png"
          alt="Research Methods"
          class="rounded-xl border w-full h-auto md:flex-1 md:min-h-0 md:h-full object-contain"
        />
      </figure>
    </div>
  </section>

  <!-- Process -->
  <section
    id="findings"
    class="scroll-mt-40 md:flex md:items-stretch gap-x-10"
    role="region"
    aria-labelledby="findings-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="findings-heading" class="text-2xl font-semibold">Process</h2>
      <p>
        Train individual users' speech to create custom voice commands (wake-words) to operate telephone services
      </p>
    </article>
    <div class="md:w-[65%] md:flex md:flex-col mt-6 md:mt-0">
      <figure class="flex-1 flex flex-col min-h-0">
        <img
          src="/images/asr-process.png"
          alt="Process"
          class="rounded-xl border w-full h-auto md:flex-1 md:min-h-0 md:h-full object-contain"
        />
      </figure>
    </div>
  </section>

  <!-- Demo -->
  <section
    id="recommendations"
    class="scroll-mt-40 md:flex md:items-stretch gap-x-10"
    role="region"
    aria-labelledby="recommendations-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="recommendations-heading" class="text-2xl font-semibold">Demo</h2>
      <p>
        A demonstration of the single-switch accessible voice web application I independently developed
      </p>
    </article>
    <div class="md:w-[65%] md:flex md:flex-col mt-6 md:mt-0">
      <figure class="flex-1 flex flex-col min-h-0">
        <video
          id="demo-video"
          src="/videos/asr-demo.mp4"
          controls
          onloadedmetadata="this.playbackRate=0.5"
          class="rounded-xl border w-full h-auto md:flex-1 md:min-h-0 md:h-full object-contain"
          aria-label="Web App Demonstration"
          tabindex="0"
        >
          Your browser does not support the video tag.
        </video>
      </figure>
    </div>
  </section>

  <!-- Publication -->
  <section
    id="publication"
    class="scroll-mt-40 md:flex md:items-stretch gap-x-10"
    role="region"
    aria-labelledby="publication-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="publication-heading" class="text-2xl font-semibold">Publication</h2>
      <p>
        Academic publication disseminating my research-- presented at the International Conference on Helping People with special
        Needs 2020
      </p>
    </article>
    <div class="md:w-[65%] md:flex md:flex-col mt-6 md:mt-0">
      <figure class="flex-1 flex flex-col min-h-0">
        <iframe
          src="/docs/asr-icchp.pdf"
          class="w-full h-[720px] md:flex-1 md:min-h-0 md:h-full rounded-xl border"
          title="Tecla Sound PDF"
        ></iframe>
      </figure>
    </div>
  </section>
</SectionedPageLayout>

<script>
  function setDemoPlaybackRate() {
    const demoVideo = document.getElementById('demo-video') as HTMLVideoElement | null;
    if (demoVideo) {
      demoVideo.defaultPlaybackRate = 0.5;
      demoVideo.playbackRate = 0.5;
    }
  }

  document.addEventListener('DOMContentLoaded', setDemoPlaybackRate);
  document.addEventListener('astro:page-load', setDemoPlaybackRate);
</script>