---
// src/pages/machine-learning.astro
import SectionedPageLayout from '../layouts/SectionedPageLayout.astro';
import type { SectionItem } from '../components/SectionSidebar.astro';

const sections: SectionItem[] = [
  { id: 'preamble', label: 'Preamble' },
  { id: 'problem', label: 'Problem' },
  { id: 'methods', label: 'Methods' },
  { id: 'findings', label: 'Process' },
  { id: 'recommendations', label: 'Recommendations' },
  { id: 'publication-1', label: 'Publication 1' },
  { id: 'publication-2', label: 'Publication 2' },
];
---

<SectionedPageLayout title="Machine Learning for Speech Disorders" sections={sections}>
  <!-- Preamble -->
  <section
    id="preamble"
    class="scroll-mt-40 md:flex md:items-stretch gap-x-10"
    role="region"
    aria-labelledby="preamble-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="preamble-heading" class="text-2xl font-semibold">Preamble</h2>
      <p>In my "ASR for Dysarthria" project I outlined an interface solution to the problems that quadriplegics face.</p>
      <p>Please navigate to that project from the drop-down as it was the preliminary work for this one.</p>
      <p>This solution was limited to current state-of-art which is ineffective.</p>
    </article>
    <div class="md:w-[65%] md:flex md:flex-col mt-6 md:mt-0">
      <figure class="flex-1 flex flex-col min-h-0">
        <img
          src="/images/ml-grid.png"
          alt="Background Information: Pictoral grid showing current ASR systems are lacking"
          class="rounded-xl border w-full h-auto md:flex-1 md:min-h-0 md:h-full object-contain"
        />
      </figure>
    </div>
  </section>

  <!-- Problem -->
  <section
    id="problem"
    class="scroll-mt-40 md:flex md:items-stretch gap-x-10"
    role="region"
    aria-labelledby="problem-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="problem-heading" class="text-2xl font-semibold">Problem</h2>
      <p>
        Dysarthric speech has more diffuse regions than non-disordered speech, so generic voice assistants like Alexa and
        Siri do not recognize voice commands
      </p>
    </article>
    <div class="md:w-[65%] md:flex md:flex-col mt-6 md:mt-0">
      <figure class="flex-1 flex flex-col min-h-0">
        <img
          src="/images/ml-problem.png"
          alt="Waveform image showing sysarthric speech has more diffuse regions than non-disordered speech"
          class="rounded-xl border w-full h-auto md:flex-1 md:min-h-0 md:h-full object-contain"
        />
      </figure>
    </div>
  </section>

  <!-- Methods -->
  <section
    id="methods"
    class="scroll-mt-40 md:flex md:items-stretch gap-x-10"
    role="region"
    aria-labelledby="methods-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="methods-heading" class="text-2xl font-semibold">Methods</h2>
      <p>
        Voice assistants use transformers trained on massive datasets, but the amount of training data for dysarthric
        speech is insufficient
      </p>
    </article>
    <!-- Need to replace this with a table for accessibility -->
    <div class="md:w-[65%] md:flex md:flex-col mt-6 md:mt-0">
      <figure class="flex-1 flex flex-col min-h-0">
        <img
          src="/images/ml-methods.png"
          alt="Outline of training data provided by different datasets"
          class="rounded-xl border w-full h-auto md:flex-1 md:min-h-0 md:h-full object-contain"
        />
      </figure>
    </div>
  </section>

  <!-- Process -->
  <section
    id="findings"
    class="scroll-mt-40 md:flex md:items-stretch gap-x-10"
    role="region"
    aria-labelledby="findings-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="findings-heading" class="text-2xl font-semibold">Process</h2>
      <p>
        Proposed a two-stage training process (fine-tuning a speech-based Large Language Model like ChatGPT) and
        wake-word detection process
      </p>
    </article>
    <div class="md:w-[65%] md:flex md:flex-col mt-6 md:mt-0">
      <figure class="flex-1 flex flex-col min-h-0">
        <img
          src="/images/ml-process.png"
          alt="Process"
          class="rounded-xl border w-full h-auto md:flex-1 md:min-h-0 md:h-full object-contain"
        />
      </figure>
    </div>
  </section>

  <!-- Recommendations -->
  <section
    id="recommendations"
    class="scroll-mt-40 md:flex md:items-stretch gap-x-10"
    role="region"
    aria-labelledby="recommendations-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="recommendations-heading" class="text-2xl font-semibold">Recommendations</h2>
      <p>Collected the largest dataset of dysarthric speech and used SpeechBrain to train on the latest transformers.</p>
      <p>Training revealed that the tranformer could not converge on keyword spotting.</p>
      <p>
        Alternatively, tried merging samples to create longer tokens, but this reduced the number of observations
        preventing learning.
      </p>
    </article>
    <div class="md:w-[65%] md:flex md:flex-col mt-6 md:mt-0">
      <figure class="flex-1 flex flex-col min-h-0">
        <img
          src="/images/ml-speechbrain.png"
          alt="Logo of Transformer library used"
          class="rounded-xl border w-full h-auto md:flex-1 md:min-h-0 md:h-full object-contain"
        />
      </figure>
    </div>
  </section>

  <!-- Publication 1 -->
  <section
    id="publication-1"
    class="scroll-mt-40 md:flex md:items-stretch gap-x-10"
    role="region"
    aria-labelledby="publication-1-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="publication-1-heading" class="text-2xl font-semibold">Publication 1</h2>
      <p>
        Literature Review conducted summarizing research and surverying state-of-the-art for Automatic Speech
        Recognition.
      </p>
    </article>
    <div class="md:w-[65%] md:flex md:flex-col mt-6 md:mt-0">
      <figure class="flex-1 flex flex-col min-h-0">
        <iframe
          src="/docs/ml_asr_yrc.pdf"
          class="w-full h-[720px] md:flex-1 md:min-h-0 md:h-full rounded-xl border"
          title="Literature Review of Automatic Speech Recongition"
        ></iframe>
      </figure>
    </div>
  </section>

  <!-- Publication 2 -->
  <section
    id="publication-2"
    class="scroll-mt-40 md:flex md:items-stretch gap-x-10"
    role="region"
    aria-labelledby="publication-2-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="publication-2-heading" class="text-2xl font-semibold">Publication 2</h2>
      <p>
        Academic publication disseminating my research-- presented at the Young Researchers Consoritum (ICCHP-AATE)
        2022.
      </p>
    </article>
    <div class="md:w-[65%] md:flex md:flex-col mt-6 md:mt-0">
      <figure class="flex-1 flex flex-col min-h-0">
        <iframe
          src="/docs/ml_asr_lit_review.pdf"
          class="w-full h-[720px] md:flex-1 md:min-h-0 md:h-full rounded-xl border"
          title="Young Researchers Consortium Publication"
        ></iframe>
      </figure>
    </div>
  </section>
</SectionedPageLayout>