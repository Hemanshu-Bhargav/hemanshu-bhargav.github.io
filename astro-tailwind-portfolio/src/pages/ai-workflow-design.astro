---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- =====================================================================
       LAYOUT & SCROLL-SYNC ARCHITECTURE OVERVIEW
       1. Fixed Title Header (`#page-title-header`):
          - Uses `fixed top-16 inset-x-0 z-20` to stay pinned below any top
            navigation bar provided by `Layout.astro` without overlapping
            scrolling text (adjust `top-16` if your site navbar height differs).
          - `<main>` uses `pt-36` to offset initial content below this compact
            header, and each target section uses `scroll-mt-40` so clicking an
            anchor link lands cleanly below the header.

       2. Sticky Sidebar Navigation (`<aside>` + `<nav>`):
          - The parent flex row (`<div class="md:flex gap-6">`) intentionally
            omits `items-start` so `<aside>` stretches to match the full height
            of the main content column.
          - Because `<aside>` spans the entire content height, `<nav class="sticky top-40">`
            tracks smoothly down the viewport alongside the content as you scroll
            (staying parked below the fixed header) rather than staying stranded
            at the top of the page.

       3. Deterministic Active Section Highlighting:
          - Clicking any link in the sidebar jumps to `#<section-id>`.
          - As the user scrolls, the script measures the fixed header's bottom
            edge, defines a focus line in the visible viewport below it, and
            deterministically highlights the active heading and slides `#scroll-indicator`
            to match.
       ===================================================================== -->

  <!-- =====================================================================
       REUSABLE BLOCK 1: FIXED PAGE TITLE HEADER (no bottom border)
       ===================================================================== -->
  <header
    id="page-title-header"
    class="fixed top-16 inset-x-0 z-20 bg-white shadow-sm px-6 py-4"
  >
    <div class="max-w-screen-2xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold">AI Workflow Design</h1>
    </div>
  </header>

  <main class="pt-36 px-6 pb-16 max-w-screen-2xl mx-auto min-h-screen">
    <!-- Do not add `items-start` here: `<aside>` must stretch to the full height
         of the article column so `sticky top-40` on `<nav>` travels with the content. -->
    <div class="md:flex gap-6">
      <!-- ===================================================================
           REUSABLE BLOCK 2: COMPACT SECTION SIDEBAR WITH ANCHOR LINKS
           - Narrow fixed sidebar width (`md:w-44 shrink-0`) frees up ~15–20%
             more horizontal screen real estate for the main content column.
           - Each `<a href="#<section-id>">` links to a matching `<section id="<section-id>">`.
           - Update `id="nav-<section-id>"` and link labels to match your page's sections.
           =================================================================== -->
      <aside
        class="hidden md:block md:w-44 shrink-0 text-sm font-medium"
        role="complementary"
        aria-label="Section Navigation"
      >
        <nav
          class="sticky top-40 relative pl-3 border-l border-gray-200 space-y-2"
          aria-label="Sidebar Navigation"
        >
          <!-- Active indicator bar positioned deterministically by the script below -->
          <span
            id="scroll-indicator"
            aria-hidden="true"
            class="absolute -left-[2px] top-0 h-7 w-[3px] rounded-full bg-indigo-600 transition-transform duration-150 ease-out"
          ></span>

          <a href="#problem" id="nav-problem" class="block text-gray-600 hover:text-black focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded px-2 py-1 transition-colors">Problem</a>
          <a href="#methods" id="nav-methods" class="block text-gray-600 hover:text-black focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded px-2 py-1 transition-colors">Methods</a>
          <a href="#findings" id="nav-findings" class="block text-gray-600 hover:text-black focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded px-2 py-1 transition-colors">Findings</a>
          <a href="#recommendations" id="nav-recommendations" class="block text-gray-600 hover:text-black focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded px-2 py-1 transition-colors">Recommendations</a>
          <a href="#impact" id="nav-impact" class="block text-gray-600 hover:text-black focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded px-2 py-1 transition-colors">Impact</a>
          <a href="#publication" id="nav-publication" class="block text-gray-600 hover:text-black focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded px-2 py-1 transition-colors">Presentation</a>
        </nav>
      </aside>

      <!-- ===================================================================
           REUSABLE BLOCK 3: TARGET SECTIONS
           - Each section `id` must match an entry in `SECTION_IDS` in the script
             and the corresponding `<a href="#...">` in Block 2.
           - `scroll-mt-40` prevents anchor jumps from landing under the fixed header.
           =================================================================== -->
      <section class="flex-1 min-w-0 space-y-24" aria-label="Main Article Content">
        <section id="problem" class="scroll-mt-40 md:flex gap-x-10" role="region" aria-labelledby="problem-heading" tabindex="0">
          <article class="md:w-[35%] space-y-6">
            <h2 id="problem-heading" class="text-2xl font-semibold">Problem</h2>
            <p>Live captioning is very cognitively demanding-- self-reported measures found captioning to be more stressful than surgery</p>
            <p>Automatic Speech Recognition has already replaced captioners in online meetings and post-production events</p>
            <p>Broadcasting agencies and governments are not prepared for this inevitable shift</p>
          </article>
          <div class="md:w-[65%]">
            <figure>
              <video src="/videos/live_cc_issues.mp4" controls class="rounded-xl border w-full h-auto" aria-label="Problem diagram video" tabindex="0">
                Your browser does not support the video tag.
              </video>
              <figcaption class="mt-2 text-sm text-gray-600">Live captioning is intense-- can you spot the multiple mistakes made by professional captioners?</figcaption>
            </figure>
          </div>
        </section>

        <section id="methods" class="scroll-mt-40 md:flex gap-x-10" role="region" aria-labelledby="methods-heading" tabindex="0">
          <article class="md:w-[35%] space-y-6">
            <h2 id="methods-heading" class="text-2xl font-semibold">Methods</h2>
            <p>Applied knowledge from psychology, cognitive science, computer science and industrial engineering to
              conduct a study where captioners supervised AI to write captions rather than working alone</p>
            <p>Mixed-methods approach with 21 captioners using NASA-TLX, System Usability Scale,
              Nielsen-Norman Satisfaction Scale, Trust in Automation Scale and qualitative interviews</p>
            <p>Time-series-- 3 sessions spaced 24 hours apart to allow for learning</p>
            <p>Controlled environment and pre-screened for familiarity</p>
            <p>Two independent groups: Novices and Experts-- controlled for skill level</p>
          </article>
          <div class="md:w-[65%]">
            <figure>
              <img src="/images/methods.png" alt="Research Methods" class="rounded-xl border w-full h-auto" />
              <figcaption class="mt-2 text-sm text-gray-600">Used a cross-disciplinary approach to develop measurements for 14 constructs
                in the Human Autonomy System Oversight model (which until now was theoretical).</figcaption>
            </figure>
          </div>
        </section>

        <section id="findings" class="scroll-mt-40 md:flex gap-x-10" role="region" aria-labelledby="findings-heading" tabindex="0">
          <article class="md:w-[35%] space-y-6">
            <h2 id="findings-heading" class="text-2xl font-semibold">Findings</h2>
            <p>Mitigating fear is about expectation management</p>
            <p>Captioners desire more control over AI</p>
            <p>AI reduced physical and mental workload over just 3 sessions spaced 24 hours apart</p>
          </article>
          <div class="md:w-[65%]">
            <figure>
              <img src="/images/findings.png" alt="Findings" class="rounded-xl border w-full h-auto" />
              <figcaption class="mt-2 text-sm text-gray-600">Saw a statistically significant reduction in mental workload,
                which led me to test and discover relationships not present in the original model.</figcaption>
            </figure>
          </div>
        </section>

        <section id="recommendations" class="scroll-mt-40 md:flex gap-x-10" role="region" aria-labelledby="recommendations-heading" tabindex="0">
          <article class="md:w-[35%] space-y-6">
            <h2 id="recommendations-heading" class="text-2xl font-semibold">Recommendations</h2>
            <p>Human benefit from control over AI</p>
            <p>Even if AI can automate the job, manual control should be relegated</p>
            <p>Scheduling is one recommended solution</p>
            <p>Another is interface based (see Design Mock-up from the side menu)</p>
          </article>
          <div class="md:w-[65%]">
            <figure>
              <img src="/images/loa.png" alt="Recommendations" class="rounded-xl border w-full h-auto" />
              <figcaption class="mt-2 text-sm text-gray-600">Based on rigorous analysis, I suggested a model where control and automation is adaptive to user needs.
                This has far-reaching implications for human use over AI.
              </figcaption>
            </figure>
          </div>
        </section>

        <section id="impact" class="scroll-mt-40 md:flex gap-x-10" role="region" aria-labelledby="impact-heading" tabindex="0">
          <article class="md:w-[35%] space-y-6">
            <h2 id="impact-heading" class="text-2xl font-semibold">Impact</h2>
            <p>Led the only study on captioners supervising AI in the world</p>
            <p>Discovered new relationships between Human-AI constructs and made novel contributions</p>
            <p>Suggested new directions of research for human automation research.</p>
          </article>
          <div class="md:w-[65%]">
            <figure>
              <img src="/images/impact.png" alt="Impact" class="rounded-xl border w-full h-auto" />
              <figcaption class="mt-2 text-sm text-gray-600">I discovered three new relationships which better explain Human-AI Interaction contrary to theory.</figcaption>
            </figure>
          </div>
        </section>

        <section id="publication" class="scroll-mt-40 md:flex gap-x-10" role="region" aria-labelledby="publication-heading" tabindex="0">
          <article class="md:w-[35%] space-y-6">
            <h2 id="publication-heading" class="text-2xl font-semibold">Presentation</h2>
            <p>The culmination of my work was presented to key stakeholders, including the CEOs of 3PlayMedia
              and ScribeWire, representatives from broadcasters and providers (i.e Rogers) and advocacy groups</p>
            <p>Successfully defended at Toronto Metropolitan University</p>
          </article>
          <div class="md:w-[65%]">
            <figure>
              <iframe
                src="/docs/ai-captioning-presentation.pdf"
                class="w-full h-[360px] rounded-xl border"
                title="Thesis Defense"
              ></iframe>
              <figcaption class="mt-2 text-sm text-gray-600">Thesis presentation delivered to my defense committee.</figcaption>
            </figure>
          </div>
        </section>
      </section>
    </div>
  </main>

  <!-- =====================================================================
       REUSABLE BLOCK 4: DETERMINISTIC SCROLL-SYNC SCRIPT
       - To reuse on another page:
         1. Update `SECTION_IDS` to match your section `id` values in top-to-bottom order.
         2. Ensure each link has `id="nav-<id>"` and `href="#<id>"`.
         3. Ensure the fixed header uses `id="page-title-header"` and the
            indicator element uses `id="scroll-indicator"`.
       ===================================================================== -->
  <script>
    const SECTION_IDS = [
      "problem",
      "methods",
      "findings",
      "recommendations",
      "impact",
      "publication",
    ];

    const headerEl = document.getElementById("page-title-header");
    const indicatorEl = document.getElementById("scroll-indicator");

    // Map each section ID to its corresponding nav link and target element
    const sectionEntries = SECTION_IDS.map((id) => ({
      id,
      link: document.getElementById(`nav-${id}`),
      section: document.getElementById(id),
    }));

    // Returns the bottom Y coordinate of the fixed header so focus checks stay below it
    function getHeaderBottomOffset() {
      if (!headerEl) return 0;
      const rect = headerEl.getBoundingClientRect();
      return Math.max(0, rect.bottom);
    }

    // Moves and sizes the vertical highlight bar to align with the active link
    function syncIndicatorToLink(activeLink) {
      if (!indicatorEl || !activeLink || !activeLink.parentElement) return;
      const navRect = activeLink.parentElement.getBoundingClientRect();
      const linkRect = activeLink.getBoundingClientRect();
      const offsetY = linkRect.top - navRect.top;
      indicatorEl.style.height = `${linkRect.height}px`;
      indicatorEl.style.transform = `translateY(${offsetY}px)`;
    }

    // Applies active styling and accessibility state to the focused section's link
    function setActiveSection(activeId) {
      let activeLink = null;

      sectionEntries.forEach(({ link, id }) => {
        if (!link) return;
        const isActive = id === activeId;

        if (isActive) {
          activeLink = link;
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }

        link.classList.toggle("text-indigo-700", isActive);
        link.classList.toggle("text-black", isActive);
        link.classList.toggle("font-semibold", isActive);
        link.classList.toggle("text-gray-600", !isActive);
      });

      syncIndicatorToLink(activeLink);
    }

    // Deterministically determines which section currently owns the viewport focus line
    function resolveFocusedSectionId() {
      const topOffset = getHeaderBottomOffset();
      const focusLine = topOffset + (window.innerHeight - topOffset) * 0.3;

      const atPageBottom =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 24;
      if (atPageBottom && sectionEntries.length > 0) {
        return sectionEntries[sectionEntries.length - 1].id;
      }

      let focusedId = sectionEntries[0]?.id ?? "";
      for (const { id, section } of sectionEntries) {
        if (!section) continue;
        const rect = section.getBoundingClientRect();
        if (rect.top <= focusLine) {
          focusedId = id;
        } else {
          break;
        }
      }

      return focusedId;
    }

    // Coalesce scroll and resize events into one animation frame per tick
    let frameScheduled = false;
    function scheduleScrollSync() {
      if (frameScheduled) return;
      frameScheduled = true;
      window.requestAnimationFrame(() => {
        setActiveSection(resolveFocusedSectionId());
        frameScheduled = false;
      });
    }

    window.addEventListener("DOMContentLoaded", () => {
      setActiveSection(resolveFocusedSectionId());
      window.addEventListener("scroll", scheduleScrollSync, { passive: true });
      window.addEventListener("resize", scheduleScrollSync, { passive: true });
    });
  </script>
</Layout>