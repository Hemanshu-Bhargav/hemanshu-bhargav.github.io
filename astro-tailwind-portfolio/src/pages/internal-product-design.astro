---
// src/pages/internal-product-design.astro
import SectionedPageLayout from '../layouts/SectionedPageLayout.astro';
import type { SectionItem } from '../components/SectionSidebar.astro';

const sections: SectionItem[] = [
  { id: 'preamble', label: 'Preamble' },
  { id: 'problem', label: 'Problem' },
  { id: 'recommendations', label: 'Recommendations' },
  { id: 'publication-1', label: 'Publication 1' },
  { id: 'publication-2', label: 'Publication 2' },
];
---

<SectionedPageLayout title="PromoBoss" sections={sections}>
  <!-- Preamble -->
  <section
    id="preamble"
    class="scroll-mt-40 md:flex gap-x-10"
    role="region"
    aria-labelledby="preamble-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="preamble-heading" class="text-2xl font-semibold">Preamble</h2>
      <p>......</p>
    </article>
    <div class="md:w-[65%]">
      <figure>
        <img
          src="/images/ml-grid.png"
          alt="Background Information: Pictoral grid showing current ASR systems are lacking"
          class="rounded-xl border w-full h-auto"
        />
      </figure>
    </div>
  </section>

  <!-- Problem -->
  <section
    id="problem"
    class="scroll-mt-40 md:flex gap-x-10"
    role="region"
    aria-labelledby="problem-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="problem-heading" class="text-2xl font-semibold">Problem</h2>
      <p>...</p>
    </article>
    <div class="md:w-[65%]">
      <figure>
        <img
          src="/images/ml-problem.png"
          alt="Waveform image showing sysarthric speech has more diffuse regions than non-disordered speech"
          class="rounded-xl border w-full h-auto"
        />
      </figure>
    </div>
  </section>

  <!-- Recommendations -->
  <section
    id="recommendations"
    class="scroll-mt-40 md:flex gap-x-10"
    role="region"
    aria-labelledby="recommendations-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="recommendations-heading" class="text-2xl font-semibold">Recommendations</h2>
      <p>Collected</p>
    </article>
    <div class="md:w-[65%]">
      <figure>
        <img
          src="/images/ml-speechbrain.png"
          alt="Logo of Transformer library used"
          class="rounded-xl border w-full h-auto"
        />
      </figure>
    </div>
  </section>

  <!-- Publication 1 -->
  <section
    id="publication-1"
    class="scroll-mt-40 md:flex gap-x-10"
    role="region"
    aria-labelledby="publication-1-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="publication-1-heading" class="text-2xl font-semibold">Publication 1</h2>
      <p>Literature Review</p>
    </article>
    <div class="md:w-[65%]">
      <figure>
        <iframe
          src="/docs/ml_asr_yrc.pdf"
          class="w-full h-[720px] rounded-xl border"
          title="Literature Review of Automatic Speech Recongition"
        ></iframe>
      </figure>
    </div>
  </section>

  <!-- Publication 2 -->
  <section
    id="publication-2"
    class="scroll-mt-40 md:flex gap-x-10"
    role="region"
    aria-labelledby="publication-2-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="publication-2-heading" class="text-2xl font-semibold">Publication 2</h2>
      <p>
        Academic publication disseminating my research-- presented at the Young Researchers Consoritum (ICCHP-AATE)
        2022.
      </p>
    </article>
    <div class="md:w-[65%]">
      <figure>
        <iframe
          src="/docs/ml_asr_lit_review.pdf"
          class="w-full h-[720px] rounded-xl border"
          title="Young Researchers Consortium Publication"
        ></iframe>
      </figure>
    </div>
  </section>
</SectionedPageLayout>