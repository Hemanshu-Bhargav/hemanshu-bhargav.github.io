---
// src/pages/biomechanical-consulting.astro
import SectionedPageLayout from '../layouts/SectionedPageLayout.astro';
import type { SectionItem } from '../components/SectionSidebar.astro';

const sections: SectionItem[] = [
  { id: 'problem', label: 'Problem' },
  { id: 'methods', label: 'Methods' },
  { id: 'process', label: 'Process' },
  { id: 'improvements', label: 'Demo' },
  { id: 'analysis', label: 'Analysis' },
  { id: 'results', label: 'Results' },
];
---

<SectionedPageLayout title="Biomechanical Consulting" sections={sections}>
  <!-- Problem -->
  <section
    id="problem"
    class="scroll-mt-40 md:flex gap-x-10"
    role="region"
    aria-labelledby="problem-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="problem-heading" class="text-2xl font-semibold">Problem</h2>
      <p>Partnered with a custodial service to identify pain points among staff.</p>
    </article>
    <div class="md:w-[65%]">
      <img src="/images/consulting-slide.png" alt="Case" class="rounded-xl border w-full h-auto" />
    </div>
  </section>

  <!-- Methods -->
  <section
    id="methods"
    class="scroll-mt-40 md:flex gap-x-10"
    role="region"
    aria-labelledby="methods-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="methods-heading" class="text-2xl font-semibold">Methods</h2>
      <p>Conducted a HTA to understand current operations.</p>
      <p>
        Prior to beginning interventions to reduce MSP, immediately identified operational inefficiencies unbeknowst to
        experienced staff.
      </p>
    </article>
    <div class="md:w-[65%]">
      <img src="/images/hta_pre.png" alt="Research Methods" class="rounded-xl border w-full h-auto" />
    </div>
  </section>

  <!-- Process -->
  <section
    id="process"
    class="scroll-mt-40 md:flex gap-x-10"
    role="region"
    aria-labelledby="process-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="process-heading" class="text-2xl font-semibold">Process</h2>
      <p>
        Despite lacking experience in the business, my proposed processed immediately improved productivity with a nearly
        60% reduction in non-direct work
      </p>
    </article>
    <div class="md:w-[65%]">
      <img src="/images/hta_post.png" alt="HTA_Post" class="rounded-xl border w-full h-auto" />
    </div>
  </section>

  <!-- Demo / Improvements -->
  <section
    id="improvements"
    class="scroll-mt-40 md:flex gap-x-10"
    role="region"
    aria-labelledby="improvements-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="improvements-heading" class="text-2xl font-semibold">Demo</h2>
      <p>Performed biomechnicalling modelling to identify shear compression forces and reduce workplace injuries.</p>
    </article>
    <div class="md:w-[65%]">
      <img src="/images/pre_intervention.png" alt="Improvements" class="rounded-xl border w-full h-auto" />
    </div>
  </section>

  <!-- Analysis -->
  <section
    id="analysis"
    class="scroll-mt-40 md:flex gap-x-10"
    role="region"
    aria-labelledby="analysis-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="analysis-heading" class="text-2xl font-semibold">Analysis</h2>
      <p>Leveraged biomechanical knowledge to propose interventions that reduced loading forces by 97.5%</p>
    </article>
    <div class="md:w-[65%]">
      <img src="/images/post_intervention.png" alt="Analysis" class="rounded-xl border w-full h-auto" />
    </div>
  </section>

  <!-- Results -->
  <section
    id="results"
    class="scroll-mt-40 md:flex gap-x-10"
    role="region"
    aria-labelledby="results-heading"
    tabindex="0"
  >
    <article class="md:w-[35%] space-y-6">
      <h2 id="results-heading" class="text-2xl font-semibold">Results</h2>
      <p>Resulting interventions reduced work by up to 60%.</p>
    </article>
    <div class="md:w-[65%]">
      <img src="/images/percent_reduction.png" alt="Results" class="rounded-xl border w-full h-auto" />
    </div>
  </section>
</SectionedPageLayout>

<script>
  function setDemoPlaybackRate() {
    const demoVideo = document.getElementById('demo-video') as HTMLVideoElement | null;
    if (demoVideo) {
      demoVideo.defaultPlaybackRate = 0.5;
      demoVideo.playbackRate = 0.5;
    }
  }

  document.addEventListener('DOMContentLoaded', setDemoPlaybackRate);
  document.addEventListener('astro:page-load', setDemoPlaybackRate);
</script>