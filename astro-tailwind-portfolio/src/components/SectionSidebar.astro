---
// src/components/SectionSidebar.astro
// Reusable section index sidebar with deterministic scroll-position highlighting.

export interface SectionItem {
  id: string;    // Must match the `id` attribute of the target `<section>` on the page
  label: string; // Visible navigation text rendered in the sidebar link
}

interface Props {
  sections?: SectionItem[]; // Custom section list per page; defaults to standard sections
  headerId?: string;         // ID of the fixed title header used to offset focus calculations
}

const {
  sections = [
    { id: 'problem', label: 'Problem' },
    { id: 'methods', label: 'Methods' },
    { id: 'findings', label: 'Findings' },
    { id: 'recommendations', label: 'Recommendations' },
    { id: 'impact', label: 'Impact' },
    { id: 'publication', label: 'Presentation' },
  ],
  headerId = 'page-title-header',
} = Astro.props;
---

<!-- Hidden on small screens; stretches with the parent flex row on desktop (`md:w-44 shrink-0`) -->
<aside
  class="hidden md:block md:w-44 shrink-0 text-sm font-medium"
  role="complementary"
  aria-label="Section Navigation"
  data-section-sidebar
  data-header-id={headerId}
>
  <!-- `sticky top-40` keeps the index tracking alongside scrolling content below the fixed header -->
  <nav
    class="sticky top-40 relative pl-3 border-l border-gray-200 space-y-2"
    aria-label="Sidebar Navigation"
  >
    <!-- Vertical accent bar moved/resized via transform and height in the script below -->
    <span
      data-scroll-indicator
      aria-hidden="true"
      class="absolute -left-[2px] top-0 h-7 w-[3px] rounded-full bg-indigo-600 transition-transform duration-150 ease-out"
    ></span>

    <!-- Render an anchor link for each configured section -->
    {
      sections.map(({ id, label }) => (
        <a
          href={`#${id}`}
          data-nav-target={id}
          class="block text-gray-600 hover:text-black focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded px-2 py-1 transition-colors"
        >
          {label}
        </a>
      ))
    }
  </nav>
</aside>

<script>
  // Initializes scroll-sync behavior for all sidebar instances on the current page
  function initSectionSidebars() {
    const sidebars = document.querySelectorAll<HTMLElement>('[data-section-sidebar]');

    sidebars.forEach((sidebar) => {
      // Guard against duplicate event listeners across page loads or Astro transitions
      if (sidebar.dataset.initialized === 'true') return;
      sidebar.dataset.initialized = 'true';

      const headerId = sidebar.dataset.headerId || 'page-title-header';
      const headerEl = document.getElementById(headerId);
      const indicatorEl = sidebar.querySelector<HTMLElement>('[data-scroll-indicator]');
      const links = Array.from(sidebar.querySelectorAll<HTMLAnchorElement>('[data-nav-target]'));

      // Pair each nav link with its DOM section and drop any IDs absent from this page
      const sectionEntries = links
        .map((link) => {
          const id = link.dataset.navTarget || '';
          return {
            id,
            link,
            section: document.getElementById(id),
          };
        })
        .filter((entry) => entry.section !== null);

      if (sectionEntries.length === 0) return;

      // Returns the bottom edge of the fixed header so focus detection stays below it
      function getHeaderBottomOffset() {
        if (!headerEl) return 0;
        const rect = headerEl.getBoundingClientRect();
        return Math.max(0, rect.bottom);
      }

      // Aligns the vertical indicator bar's height and vertical offset with the active link
      function syncIndicatorToLink(activeLink: HTMLAnchorElement | null) {
        if (!indicatorEl || !activeLink || !activeLink.parentElement) return;
        const navRect = activeLink.parentElement.getBoundingClientRect();
        const linkRect = activeLink.getBoundingClientRect();
        const offsetY = linkRect.top - navRect.top;
        indicatorEl.style.height = `${linkRect.height}px`;
        indicatorEl.style.transform = `translateY(${offsetY}px)`;
      }

      // Updates active classes, `aria-current`, and indicator position for the focused section
      function setActiveSection(activeId: string) {
        let activeLink: HTMLAnchorElement | null = null;

        sectionEntries.forEach(({ link, id }) => {
          const isActive = id === activeId;

          if (isActive) {
            activeLink = link;
            link.setAttribute('aria-current', 'location');
          } else {
            link.removeAttribute('aria-current');
          }

          link.classList.toggle('text-indigo-700', isActive);
          link.classList.toggle('text-black', isActive);
          link.classList.toggle('font-semibold', isActive);
          link.classList.toggle('text-gray-600', !isActive);
        });

        syncIndicatorToLink(activeLink);
      }

      // Deterministically picks the active section based on a focus line below the header
      function resolveFocusedSectionId(): string {
        const topOffset = getHeaderBottomOffset();
        const focusLine = topOffset + (window.innerHeight - topOffset) * 0.3;

        // Snap to the last section when scrolled near the bottom of the document
        const atPageBottom =
          window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 24;
        if (atPageBottom) {
          return sectionEntries[sectionEntries.length - 1].id;
        }

        // Otherwise pick the last section whose top has passed above the focus line
        let focusedId = sectionEntries[0].id;
        for (const { id, section } of sectionEntries) {
          if (!section) continue;
          const rect = section.getBoundingClientRect();
          if (rect.top <= focusLine) {
            focusedId = id;
          } else {
            break;
          }
        }

        return focusedId;
      }

      // Throttle scroll/resize updates to at most once per animation frame
      let frameScheduled = false;
      function scheduleScrollSync() {
        if (frameScheduled) return;
        frameScheduled = true;
        window.requestAnimationFrame(() => {
          setActiveSection(resolveFocusedSectionId());
          frameScheduled = false;
        });
      }

      // Run an initial sync on mount and listen to scroll and resize events
      setActiveSection(resolveFocusedSectionId());
      window.addEventListener('scroll', scheduleScrollSync, { passive: true });
      window.addEventListener('resize', scheduleScrollSync, { passive: true });
    });
  }

  // Support both initial DOM load and Astro client-side navigation (`astro:page-load`)
  document.addEventListener('DOMContentLoaded', initSectionSidebars);
  document.addEventListener('astro:page-load', initSectionSidebars);
</script>