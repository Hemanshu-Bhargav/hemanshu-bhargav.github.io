---
import Layout from '../layouts/Layout.astro';
---

<style>
  /* Basic Reset */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Full-width Navigation Bar */
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 1rem 2rem;
    background: #1a1a1a;
    color: white;
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 1rem;
  }

  nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
  }

  nav a:hover {
    color: #00bcd4;
  }

  /* Accessibility Focus Indicator */
  button:focus, a:focus {
    outline: none;
    box-shadow: 0px 0px 8px rgba(0, 188, 212, 0.8);
  }

  /* Hero Section */
  .hero {
    display: flex;
    height: 90vh;
    justify-content: center;
    align-items: center;
    background: #121212;
    color: white;
    font-size: 2rem;
    font-family: Arial, sans-serif;
  }

  /* Spaced-Out Animated Name */
  .animated-text span {
    opacity: 0;
    transform: translateY(20px);
    display: inline-block;
    animation: fadeInUp 1s ease forwards;
    letter-spacing: 0.3rem; /* Spaced letters */
  }

  .animated-text span:nth-child(1) { animation-delay: 0.3s; }
  .animated-text span:nth-child(2) { animation-delay: 0.6s; }
  .animated-text span:nth-child(3) { animation-delay: 0.9s; }
  .animated-text span:nth-child(4) { animation-delay: 1.2s; }
  .animated-text span:nth-child(5) { animation-delay: 1.5s; }
  .animated-text span:nth-child(6) { animation-delay: 1.8s; }
  .animated-text span:nth-child(7) { animation-delay: 2.1s; }
  .animated-text span:nth-child(8) { animation-delay: 2.4s; }

  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Braille-Inspired Background Dots */
  .braille-bg {
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
    background-size: 10px 10px;
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    pointer-events: none;
  }

</style>

<Layout>
  <!-- Full-Width Navigation Bar -->
  <nav>
    <h1>My Portfolio</h1>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/projects">Projects</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
  </nav>

  <!-- Hero Section with Braille-Inspired Background -->
  <section class="hero">
    <div class="braille-bg"></div>
    <div class="animated-text">
      <span>H</span><span>i</span>, <span>m</span><span>y</span> <span>n</span><span>a</span><span>m</span><span>e</span> <span>i</span><span>s</span>
      <br />
      <span>H</span><span>e</span><span>m</span><span>a</span><span>n</span><span>s</span><span>h</span><span>u</span>
    </div>
  </section>
</Layout>